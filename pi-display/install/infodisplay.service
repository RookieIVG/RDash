[Unit]
Description=InfoDisplay Empfänger (Bluetooth + lokale Anzeige)
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
Type=simple
User=infodisplay
Group=infodisplay
WorkingDirectory=/opt/infodisplay
# Bluetooth vor jedem Start freigeben und einschalten (als root, Fehler werden ignoriert),
# falls es per rfkill gesperrt wurde ("Soft blocked: yes" / "Failed to set power on")
ExecStartPre=-+/usr/sbin/rfkill unblock bluetooth
ExecStartPre=-+/usr/bin/timeout 10 /usr/bin/bluetoothctl power on
ExecStart=/usr/bin/python3 /opt/infodisplay/receiver.py --config /etc/infodisplay/config.ini
# Darf die Systemzeit stellen (Uhrzeit vom PC übernehmen, [time] sync_from_pc) – sonst keine Sonderrechte
AmbientCapabilities=CAP_SYS_TIME
Restart=always
RestartSec=5

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ReadWritePaths=/var/log/infodisplay
ReadOnlyPaths=/etc/infodisplay /opt/infodisplay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
